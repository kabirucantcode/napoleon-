# Napoleon — standalone operational intelligence API
#
# Copy to `.env` and fill in. Nothing here is shared with Spectra.

# Postgres. Napoleon owns this database; it is not Spectra's.
DATABASE_URL="postgresql://user:password@localhost:5432/napoleon?schema=public"

# HTTP port.
PORT=3010

# Comma-separated list of browser origins allowed to call this API.
# Leave empty to disable CORS entirely (server-to-server callers are unaffected;
# they do not preflight).
CORS_ORIGIN=""

# Bootstrap-only: the organization created by `npm run bootstrap`, and the name
# of the first key. Used once, then unused.
BOOTSTRAP_ORG_NAME="My Organization"
BOOTSTRAP_ORG_SLUG="my-org"
BOOTSTRAP_KEY_NAME="bootstrap"
